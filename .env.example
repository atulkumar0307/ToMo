NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://user:password@localhost:5432/tomo_db?schema=public"

JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

JWT_ADMIN_ACCESS_SECRET=your-admin-access-secret-change-in-production
JWT_ADMIN_REFRESH_SECRET=your-admin-refresh-secret-change-in-production
JWT_ADMIN_ACCESS_EXPIRES_IN=15m
JWT_ADMIN_REFRESH_EXPIRES_IN=7d

OTP_EXPIRY_MINUTES=10
DEV_OTP=000000

# --- Realtime push (Firebase Cloud Messaging, silent data messages) ---
# Service-account JSON (raw or base64) from Firebase console → Project settings →
# Service accounts → Generate new private key. Empty = push disabled (app still works).
FIREBASE_SERVICE_ACCOUNT=
# …or a path to the JSON file instead:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Rules & housekeeping (defaults shown) ---
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# ACTIVITY_START_EARLY_MINUTES=60
# ACTIVITY_AUTO_COMPLETE_GRACE_MINUTES=60
# CHAT_AFTER_END_HOURS=24
# AUDIT_LOG_RETENTION_DAYS=180
# Signs private photo links (defaults to JWT_ADMIN_ACCESS_SECRET)
# MEDIA_SIGNING_SECRET=
# Behind nginx / a load balancer, so rate limits see the real client IP:
# TRUST_PROXY=1
